<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- P 站图片管理：分享 filesDir/pixiv_downloads 下的已保存原图 -->
    <files-path
        name="pixiv_downloads"
        path="pixiv_downloads/" />
    <!-- 系统相机拍照：输出到 cacheDir/camera_shots，经同一 FileProvider 授权给相机应用 -->
    <cache-path
        name="camera_shots"
        path="camera_shots/" />
</paths>
