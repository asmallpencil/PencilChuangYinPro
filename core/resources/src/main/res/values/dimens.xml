    <!--
      原生玻璃开关的**占位框**尺寸。原生层（lg/Toggle.cpp）以
      GlassConfig.h 的 TOGGLE_TRACK_W_DP(64) / TOGGLE_TRACK_H_DP(28) 绘制轨道，
      并把它**在占位框内居中**；占位框同时是原生命中区域，故宽度需 ≥ 轨道宽度、
      高度留出少量纵向余量。集中为资源，避免各调用点散落的魔法数字。
    -->
    <dimen name="dimen_liquid_glass_toggle_w">64dp</dimen>
    <dimen name="dimen_liquid_glass_toggle_h">32dp</dimen>
